<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Midi</RootNamespace>
    <AssemblyName>midilib</AssemblyName>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <!-- Keep the hand-authored Properties\AssemblyInfo.cs instead of generating one. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provides System.IO.FileFormatException, which lived in WindowsBase on .NET Framework. -->
    <PackageReference Include="System.IO.Packaging" Version="10.0.9" />
  </ItemGroup>

</Project>
